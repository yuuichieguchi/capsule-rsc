{
  "name": "@capsulersc/compiler",
  "version": "0.0.1",
  "description": "ESLint plugin for CapsuleRSC boundary enforcement",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "rsc",
    "boundary"
  ],
  "license": "MIT",
  "author": "Yuuichi Eguchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuuichieguchi/capsule-rsc.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/yuuichieguchi/capsule-rsc#readme",
  "bugs": {
    "url": "https://github.com/yuuichieguchi/capsule-rsc/issues"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.8",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
