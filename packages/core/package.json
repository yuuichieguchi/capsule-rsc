{
  "name": "@capsulersc/core",
  "version": "0.0.1",
  "description": "Core types and runtime validation for CapsuleRSC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "rsc",
    "react-server-components",
    "serializable",
    "boundary"
  ],
  "license": "MIT",
  "author": "Yuuichi Eguchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuuichieguchi/capsule-rsc.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/yuuichieguchi/capsule-rsc#readme",
  "bugs": {
    "url": "https://github.com/yuuichieguchi/capsule-rsc/issues"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
